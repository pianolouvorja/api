NODE_ENV=development
PORT=3100
DB_PATH=./data/catalog.db
MEDIA_DIR=./media
UPSTREAM_API=https://api.louvorja.com.br
FIREBASE_PROJECT_ID=pianolouvorja
CACHE_TTL_HYMN=86400
CACHE_TTL_AUDIO=3600
CACHE_TTL_BIBLE=604800
RATE_LIMIT_PER_MIN=100
# Origens CORS separadas por vírgula (default * para compat com apps)
CORS_ORIGINS=*
# true apenas atrás de proxy confiável (Cloudflare Tunnel) — habilita X-Forwarded-For no rate limit
TRUSTED_PROXY=false
