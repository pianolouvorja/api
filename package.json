{
  "name": "piano-api",
  "version": "0.2.0",
  "description": "API propria pianolouvorja — hinarios SDA e Louvor JA",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.app.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "validate:pr": "biome check src/ test/ && tsc -p tsconfig.test.json --noEmit && vitest run",
    "import:upstream": "tsx scripts/import-upstream.ts",
    "import:sda": "tsx scripts/import-sda-hymnal.ts",
    "version:major": "npm version major -m \"chore: versão %s\"",
    "version:minor": "npm version minor -m \"chore: versão %s\"",
    "version:patch": "npm version patch -m \"chore: versão %s\"",
    "version:max": "npm run version:major",
    "version:min": "npm run version:minor",
    "version:bug": "npm run version:patch",
    "prepare": "[ \"$NODE_ENV\" = production ] || husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^0.18.0",
    "@scalar/hono-api-reference": "^0.11.13",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.6.0",
    "kysely": "^0.29.5",
    "ws": "^8.21.3",
    "zod": "^3.23.0"
  },
  "lint-staged": {
    "*.{ts,json}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@hono/node-ws": "^1.3.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
